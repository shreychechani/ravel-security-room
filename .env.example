# Copy to .env and fill in. Never commit .env.
# Switch Agent Protocol endpoints for the ravel agent (get exact values from the Agent Protocol docs)
SWITCH_EVENTS_URL=
SWITCH_SEND_URL=
SWITCH_AGENT_TOKEN=
# How the adapter calls your Ravel CLI. {repo} and {arg} are filled in at run time.
RAVEL_REACH_CMD=ravel reach --repo {repo} --target {arg}
RAVEL_WIKI_CMD=ravel wiki --repo {repo} --module {arg}
RAVEL_CALLERS_CMD=ravel callers --repo {repo} --function {arg}
DEMO_REPO_PATH=./demo-app
