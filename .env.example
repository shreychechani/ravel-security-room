# Copy to .env and fill in. Never commit .env.

# --- Switch (Agent Protocol: WebSocket in, HTTP out) ---
# Base URL = the "api" port in
#   ~/Library/Application Support/switchdash/local-switch-server/ports.json
# Check it: curl http://127.0.0.1:<api>/health  ->  {"status":"ok"}
SWITCH_URL=http://127.0.0.1:52120
# Gateway -> API Keys -> Create Registration Key (used once, by ravel_adapter/register.py)
SWITCH_REGISTRATION_KEY=
# Written by `python -m ravel_adapter.register ravel` / `... sec-scanner`. Secrets.
RAVEL_AGENT_ID=
RAVEL_AGENT_KEY=
SCANNER_AGENT_ID=
SCANNER_AGENT_KEY=
# The security owner's Switch participant id (for the ledger line)
SECURITY_OWNER=

# --- Ravel (separate repo: github.com/shreychechani/Ravel, needs uv + Python 3.12+) ---
# Path to your Ravel clone. The adapter runs:
#   uv run --project $RAVEL_DIR ravel scan <DEMO_REPO_PATH> --limit 0 --json <tmpfile>
RAVEL_DIR=../Ravel
DEMO_REPO_PATH=./demo-app
# Optional: UV_BIN=uv (path to uv if it's not on PATH), RAVEL_TIMEOUT=120 (seconds)
